@{
    ViewData["Title"] = "Forgot Password";
}

<div class="login_page">
    <div class="login_form">
        <div class="login_header">
            <h2>Forgot Password</h2>
            <p>Enter your registered email address and we'll send you a verification code.</p>
        </div>
        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation_summary"></div>
            <div class="form_group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" class="login_input" autocomplete="email" placeholder="Enter your email address" autofocus required />
                <span class="validation_message">@Html.ValidationMessage("email")</span>
            </div>
            <button type="submit" class="login_button">Send Verification Code</button>
        </form>
        <div class="forgot_password">
            <a asp-action="Index">Back to Login</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}