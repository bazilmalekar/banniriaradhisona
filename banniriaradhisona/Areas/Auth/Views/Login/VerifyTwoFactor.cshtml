@model banniriaradhisona.Core.ViewModels.VerifyTwoFactorVM

@{
    ViewData["Title"] = "Two-Factor Authentication";
}

<div class="login_page">
    <div class="login_form">
        <div class="login_header">
            <h2>Two-Factor Authentication</h2>
            <p>Enter the 6-digit verification code from Microsoft Authenticator.</p>
        </div>
        <form asp-action="VerifyTwoFactor" method="post">
            @Html.AntiForgeryToken()
            <div class="form_group">
                <label asp-for="Code">Verification code</label>
                <input asp-for="Code" class="login_input" maxlength="6" inputmode="numeric" autocomplete="one-time-code" placeholder="Enter 6-digit code" autofocus />
                <span asp-validation-for="Code" class="validation_message"></span>
            </div>
            <button type="submit" class="login_button">Verify & Sign In</button>
        </form>
        <div class="reset_authenticator">
            <a asp-action="ResetAuthenticator">
                Reset Authenticator
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}