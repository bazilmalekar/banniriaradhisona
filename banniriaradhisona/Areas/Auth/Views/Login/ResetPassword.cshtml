@{
    ViewData["Title"] = "Reset Password";
}

<div class="login_page">
    <div class="login_form">
        <div class="login_header">
            <h2>Reset Password</h2>
            <p>Enter your new password below.</p>
        </div>
        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation_summary"></div>
            <div class="form_group">
                <label for="password">New Password</label>
                <input type="password" id="password" name="password" class="login_input" autocomplete="new-password" placeholder="Enter new password" autofocus required />
                @Html.ValidationMessage("password", new { @class = "validation_message" })
            </div>
            <div class="form_group">
                <label for="confirmPassword">Confirm New Password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" class="login_input" autocomplete="new-password" placeholder="Confirm new password" required />
                @Html.ValidationMessage("confirmPassword", new { @class = "validation_message" })
            </div>
            <button type="submit" class="login_button">Reset Password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}