@model IEnumerable<UserWithRoleVM>

<div class="admin_index">
    <!-- PAGE HEADER -->
    <div class="admin_page_header">
        <div class="admin_page_title">
            <span class="admin_page_eyebrow">Administration</span>
            <h1>Users</h1>
            <p>Manage users and their access to Banniriaradhisona.</p>
        </div>
        <div class="admin_page_actions">
            <!-- SEARCH -->
            <div class="admin_song_search">
                <input type="text" id="userSearch" placeholder="Search by name, username or role..." autocomplete="off" />
            </div>
            <!-- ADD USER -->
            <a class="admin_primary_button" asp-area="Admin" asp-controller="AppUser" asp-action="Register">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="16"
                     height="16"
                     fill="currentColor"
                     viewBox="0 0 16 16">
                    <path fill-rule="evenodd"
                          d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2" />
                </svg>
                Add User
            </a>
        </div>
    </div>
    <!-- ALERTS -->
    @if (TempData["successMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show admin_alert" role="alert">
            <strong>Success!</strong>
            @TempData["successMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["errorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show admin_alert" role="alert">
            <strong>Error!</strong>
            @TempData["errorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <!-- USER TABLE -->
    <div class="songs_table_wrapper user_table_wrapper">
        <table class="songs_list users_list">
            <thead>
                <tr>
                    <th class="user_number_column">
                        #
                    </th>
                    <th>
                        Name
                    </th>
                    <th>
                        Username
                    </th>
                    <th>
                        Role
                    </th>
                    <th class="user_manage_column">
                        Manage
                    </th>
                </tr>
            </thead>
            <tbody id="userList">
                @if (Model != null && Model.Any())
                {
                    var count = 1;
                    foreach (var user in Model)
                    {
                        <tr class="user_row" data-user-name="@user.Name" data-user-username="@user.UserName" data-user-role="@string.Join(" ", user.Roles)">
                            <td class="user_number">
                                @count
                            </td>
                            <td class="user_name">
                                @user.Name
                            </td>
                            <td class="user_username">
                                @user.UserName
                            </td>
                            <td class="user_roles">
                                @foreach (var role in user.Roles)
                                {
                                    <span class="user_role_badge @role.ToLower()">
                                        @role
                                    </span>
                                }
                            </td>
                            <td class="song_actions">
                                <!-- EDIT -->
                                <a class="song_action_button edit" asp-area="Admin" asp-controller="AppUser" asp-action="EditUser" asp-route-id="@user.Id">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="15"
                                         height="15"
                                         fill="currentColor"
                                         viewBox="0 0 16 16">
                                        <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293z" />
                                        <path d="m12.939 2.69-8 8-.805 2.414 2.414-.805 8-8z" />
                                        <path fill-rule="evenodd"
                                              d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                                    </svg>
                                    Edit
                                </a>
                                <!-- DELETE -->
                                <button type="button"
                                        class="song_action_button delete"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteUserModal"
                                        data-user-id="@user.Id"
                                        data-user-name="@user.Name"
                                        data-user-email="@user.UserName"
                                        data-user-role="@string.Join(", ", user.Roles)">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="15"
                                         height="15"
                                         fill="currentColor"
                                         viewBox="0 0 16 16">
                                        <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5" />
                                        <path d="M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1z" />
                                    </svg>
                                    Delete
                                </button>
                            </td>
                        </tr>
                        count++;
                    }
                    <tr id="noUsersFound" style="display:none;">
                        <td colspan="5">
                            <div class="songs_empty_state">
                                <strong>No users found</strong>
                                <span>No users match your search.</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="songs_empty_state">
                                <strong>No users found</strong>
                                <span>There are currently no users available.</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<!-- Delete User Confirmation Modal -->
<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin_modal">
            <!-- HEADER -->
            <div class="modal-header">
                <div class="modal_title_wrapper">
                    <div class="modal_icon delete_modal_icon">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="20"
                             height="20"
                             fill="currentColor"
                             viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                            <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z" />
                        </svg>
                    </div>
                    <h1 class="modal-title" id="deleteUserModalLabel">Delete user?</h1>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <!-- BODY -->
            <div class="modal-body">
                <p>
                    Are you sure you want to delete
                    <strong id="deleteUserName"></strong>?
                </p>
                <div class="delete_song_details">
                    <div class="delete_song_detail">
                        <span>Username</span>
                        <strong id="deleteUserEmail"></strong>
                    </div>
                    <div class="delete_song_detail">
                        <span>Role</span>
                        <strong id="deleteUserRole"></strong>
                    </div>
                </div>
                <span class="delete_warning">This action cannot be undone.</span>
            </div>
            <!-- FOOTER -->
            <div class="modal-footer">
                <button type="button" class="admin_modal_cancel" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteUserForm" method="post" asp-area="Admin" asp-controller="AppUser" asp-action="DeleteUser">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteUserId" name="id" />
                    <button type="submit" class="admin_modal_delete">Delete User</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", () => {
        // ALERTS
        const alerts = document.querySelectorAll(".admin_alert");
        alerts.forEach(alert => {
            setTimeout(() => {
                const bootstrapAlert =
                    bootstrap.Alert.getOrCreateInstance(alert);

                bootstrapAlert.close();
            }, 5000);
        });

        // DELETE MODAL
        const deleteUserModal = document.getElementById("deleteUserModal");
        const deleteUserId = document.getElementById("deleteUserId");
        const deleteUserName = document.getElementById("deleteUserName");
        const deleteUserEmail = document.getElementById("deleteUserEmail");
        const deleteUserRole = document.getElementById("deleteUserRole");
        const deleteUserForm = document.getElementById("deleteUserForm");
        const deleteUserButton = deleteUserForm?.querySelector(".admin_modal_delete");
        const deleteButtons = document.querySelectorAll(".song_action_button.delete");

        // Count Owner users
        const ownerCount =
            Array.from(deleteButtons).filter(button => {
                const roles = button.getAttribute("data-user-role") || "";
                return roles.split(",").map(role => role.trim().toLowerCase()).includes("owner");
            }).length;


        if (deleteUserModal) {
            deleteUserModal.addEventListener("show.bs.modal", event => {
                const button = event.relatedTarget;
                const userId = button.getAttribute("data-user-id");
                const userName = button.getAttribute("data-user-name");
                const userEmail = button.getAttribute("data-user-email");
                const userRole = button.getAttribute("data-user-role") || "";
                deleteUserId.value = userId;
                deleteUserName.textContent = `"${userName}"`;
                deleteUserEmail.textContent = userEmail;
                deleteUserRole.textContent = userRole;
                // LAST OWNER CHECK
                const isOwner = userRole.split(",").map(role => role.trim().toLowerCase()).includes("owner");
                const isLastOwner = isOwner && ownerCount === 1;
                if (isLastOwner) {
                    deleteUserButton.disabled = true;
                    deleteUserButton.textContent = "Cannot Delete";
                    deleteUserModal.querySelector(".delete_warning").textContent = "The last user with the Owner role cannot be deleted.";
                }
                else {
                    deleteUserButton.disabled = false;
                    deleteUserButton.textContent = "Delete User";
                    deleteUserModal.querySelector(".delete_warning").textContent = "This action cannot be undone.";
                }
            });
        }

        // USER SEARCH
        const searchInput = document.getElementById("userSearch");
        const userRows = document.querySelectorAll(".user_row");
        const noUsersFound = document.getElementById("noUsersFound");
        if (!searchInput) {
            return;
        }

        let searchTimeout;

        searchInput.addEventListener("input", () => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                const searchValue = searchInput.value.trim().toLowerCase();
                let visibleUsers = 0;
                userRows.forEach(user => {
                    const name = user.dataset.userName?.toLowerCase() ?? "";
                    const username = user.dataset.userUsername?.toLowerCase() ?? "";
                    const role = user.dataset.userRole?.toLowerCase() ?? "";
                    const matches = name.includes(searchValue) || username.includes(searchValue) || role.includes(searchValue);
                    if (matches) {
                        user.style.display = "";
                        user.classList.remove("filter_show");

                        // Restart animation
                        void user.offsetWidth;
                        user.classList.add("filter_show");
                        visibleUsers++;
                    }
                    else {
                        user.style.display = "none";
                        user.classList.remove("filter_show");
                    }
                });
                if (noUsersFound) {
                    noUsersFound.style.display = visibleUsers === 0 ? "": "none";}
            }, 250);
        });
    });
</script>