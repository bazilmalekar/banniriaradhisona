@model EditUserVM

<div class="reg_wrapper">
    <!-- HEADER -->
    <div class="reg_header">
        <div>
            <p>User Management</p>
            <h1>Edit User</h1>
            <p>Edit the user's name and role.</p>
        </div>
        <a data-bs-toggle="modal" data-bs-target="#editUserModal" class="admin_back_button">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="15"
                 height="15"
                 fill="currentColor"
                 viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 1-.5.5H2.707l4.147 4.146a.5.5 0 0 1-.708.708l-5-5a.5.5 0 0 1 0-.708l5-5a.5.5 0 1 1 .708.708L2.707 7.5H14.5A.5.5 0 0 1 15 8" />
            </svg>
            Users Dashboard
        </a>
    </div>
    <hr />
    <!-- FORM -->
    <div class="form_wrapper">
        <form asp-area="Admin" asp-controller="AppUser" asp-action="EditUser" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly"
                 class="validation_summary">
            </div>
            <input type="hidden" asp-for="Id" />
            <!-- NAME -->
            <div class="form_group">
                <label asp-for="Name"></label>
                <input asp-for="Name" placeholder="Name" autocomplete="off" />
                <span asp-validation-for="Name"></span>
            </div>
            <!-- EMAIL / USERNAME -->
            <div class="form_group">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" placeholder="Email address" autocomplete="off" readonly />
                <span asp-validation-for="Email"></span>
            </div>
            <!-- ROLE -->
            <div class="form_group">
                <label asp-for="Role"></label>
                <select asp-for="Role" asp-items="Html.GetEnumSelectList<UserRoles>()">
                    <option value="">Select role</option>
                </select>
                <span asp-validation-for="Role"></span>
            </div>
            <!-- ACTIONS -->
            <div class="form_actions">
                <a class="admin_cancel_button" data-bs-toggle="modal" data-bs-target="#editUserModal">Cancel</a>
                <button type="submit">Update User</button>
            </div>
        </form>
    </div>
</div>

<!-- LEAVE CONFIRMATION MODAL -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin_modal">
            <div class="modal-header">
                <div class="modal_title_wrapper">
                    <div class="modal_icon">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="20"
                             height="20"
                             fill="currentColor"
                             viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                            <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0l-.35 3.507a.552.552 0 0 1-1.1 0z" />
                        </svg>
                    </div>
                    <h1 class="modal-title" id="editUserModalLabel">Leave this page?</h1>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Any changes you've made will be discarded.</p>
                <span>Any unsaved changes to this user will be discarded.</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="admin_modal_cancel" data-bs-dismiss="modal">Stay</button>
                <a asp-area="Admin" asp-controller="AppUser" asp-action="Index" class="admin_modal_confirm">Leave &amp; Return</a>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}