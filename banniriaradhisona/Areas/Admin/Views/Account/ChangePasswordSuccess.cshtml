@{
    ViewData["Title"] = "Password Changed";
}

<div class="change_password_page">
    <!-- Header -->
    <div class="change_password_header">
        <div>
            <span class="change_password_eyebrow">ACCOUNT</span>
            <h1>Password Changed</h1>
            <p>Your password has been changed successfully.</p>
        </div>
    </div>
    <!-- Success Card -->
    <div class="password_success_card">
        <div class="password_success_icon">
            <svg width="28"
                 height="28"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5"></path>
            </svg>
        </div>
        <h2>Password Updated</h2>
        <p>Your password has been changed successfully. You can now continue using the application.</p>
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="admin_primary_button">Continue</a>
    </div>
</div>