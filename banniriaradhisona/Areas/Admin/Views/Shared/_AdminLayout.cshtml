@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin - Banniriaradhisona</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/adminCreate.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user.css" asp-append-version="true" />
</head>
<body>
    <div class="admin_main">
        <!-- NAVBAR -->
        <nav class="navbar custom_nav">
            <div class="admin_brand">
                <span class="admin_label">ADMIN</span>
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <img src="~/logo.png" alt="Banniriaradhisona" class="logo" />
                </a>
            </div>
            <div class="admin_nav_actions">
                <!-- View public site -->
                <a asp-area="" asp-controller="Home" asp-action="Index" class="admin_view_site">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="15"
                         height="15"
                         fill="currentColor"
                         viewBox="0 0 16 16">
                        <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16M8 1a7 7 0 1 1 0 14A7 7 0 0 1 8 1" />
                        <path d="M8 3.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9" />
                    </svg>
                    View Site
                </a>
                <!-- Logout -->
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="admin_logout_form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="admin_logout">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="15"
                             height="15"
                             fill="currentColor"
                             viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-6a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v9A1.5 1.5 0 0 0 3.5 14h6a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z" />
                            <path fill-rule="evenodd" d="M8.146 8.354a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L9.707 7.5H14.5a.5.5 0 0 1 0 1H9.707l2.147 2.146a.5.5 0 0 1-.708.708z" />
                        </svg>
                        Logout
                    </button>
                </form>
            </div>
        </nav>
        <!-- BODY -->
        <div class="admin_body_wrapper">
            <!-- SIDEBAR -->
            <aside class="admin_sidebar">
                <div class="sidebar_header">
                    <span>Administration</span>
                </div>
                <nav class="admin_navigation">
                    <a class="admin_link @(currentController == "Home" ? "active" : "")" asp-area="Admin" asp-controller="Home" asp-action="Index">
                        <span class="admin_link_icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 3.293 1 9.293V15h5v-4h4v4h5V9.293z" />
                            </svg>
                        </span>
                        <span>Dashboard</span>
                    </a>
                    <a class="admin_link @(currentController == "AppUser" ? "active" : "")" asp-area="Admin" asp-controller="AppUser" asp-action="Index">
                        <span class="admin_link_icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6" />
                                <path fill-rule="evenodd" d="M14 14s-1-1-1-4-2-4-5-4-5 1-5 4 1 4 1 4z" />
                            </svg>
                        </span>
                        <span>Users</span>
                    </a>
                </nav>
            </aside>
            <!-- CONTENT -->
            <main class="admin_body">
                @RenderBody()
            </main>
        </div>
        <!-- FOOTER -->
        <footer class="custom_footer">
            <p>
                &copy; @DateTime.Now.Year
                ಬನ್ನಿರಿ ಆರಾಧಿಸೋಣ.
                <span>All rights reserved.</span>
            </p>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>