<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Admin - Banniriaradhisona</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="icon"
          type="image/x-icon"
          href="/favicon.png" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

          <link rel="stylesheet"
          href="~/css/adminCreate.css"
          asp-append-version="true" />
          
</head>

<body>

    <div class="admin_main">

        <!-- NAVBAR -->
        <header class="admin_header">

            <nav class="navbar custom_nav">

                <div class="admin_brand">

                    <span class="admin_label">
                        ADMIN
                    </span>

                    <a asp-area="Admin"
                       asp-controller="Home"
                       asp-action="Index">

                        <img src="~/logo.png"
                             alt="Banniriaradhisona"
                             class="logo" />

                    </a>

                </div>

            </nav>

        </header>


        <!-- BODY -->
        <div class="admin_body_wrapper">

            <!-- SIDEBAR -->
            <aside class="admin_sidebar">

                <div class="sidebar_header">
                    <span>Administration</span>
                </div>


                <nav class="admin_navigation">

                    <a class="admin_link active"
                       asp-area="Admin"
                       asp-controller="Home"
                       asp-action="Index">

                        <span class="admin_link_icon">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="18"
                                 height="18"
                                 fill="currentColor"
                                 viewBox="0 0 16 16">

                                <path d="M8 3.293 1 9.293V15h5v-4h4v4h5V9.293z" />

                            </svg>
                        </span>

                        <span>
                            Dashboard
                        </span>

                    </a>


                    <a class="admin_link"
                       href="#">

                        <span class="admin_link_icon">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="18"
                                 height="18"
                                 fill="currentColor"
                                 viewBox="0 0 16 16">

                                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6" />

                                <path fill-rule="evenodd"
                                      d="M14 14s-1-1-1-4-2-4-5-4-5 1-5 4 1 4 1 4z" />

                            </svg>
                        </span>

                        <span>
                            Users
                        </span>

                    </a>

                </nav>

            </aside>


            <!-- CONTENT -->
            <main class="admin_body">

                @RenderBody()

            </main>

        </div>


        <!-- FOOTER -->
        <footer class="custom_footer">

            <p>
                &copy; @DateTime.Now.Year
                ಬನ್ನಿರಿ ಆರಾಧಿಸೋಣ.
                <span>All rights reserved.</span>
            </p>

        </footer>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>