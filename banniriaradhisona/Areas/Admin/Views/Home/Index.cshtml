@model IEnumerable<SongVM>

<div class="admin_index">
    <!-- PAGE HEADER -->
    <div class="admin_page_header">
        <div class="admin_page_title">
            <span class="admin_page_eyebrow">Content Management</span>
            <h1>Songs</h1>
            <p>Manage the songs available in Banniriaradhisona.</p>
        </div>
        <div class="admin_page_actions">
            <a type="button" class="admin_primary_button" asp-area="Admin" asp-controller="Home" asp-action="Upsert">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="16"
                     height="16"
                     fill="currentColor"
                     viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2" />
                </svg>
                Add song
            </a>
            <button type="button" class="admin_secondary_button">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="16"
                     height="16"
                     fill="currentColor"
                     viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z" />
                    <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                </svg>
                Export
            </button>
        </div>
    </div>
    @if (TempData["successMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show admin_alert" role="alert">
            <strong>Success!</strong>
            @TempData["successMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["errorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show admin_alert" role="alert">
            <strong>Error!</strong>
            @TempData["errorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <!-- SONG TABLE -->
    <div class="songs_table_wrapper">
        <table class="songs_list">
            <thead>
                <tr>
                    <th class="song_number_column">
                        Song No.
                    </th>
                    <th>
                        Song Title
                    </th>
                    <th>
                        Created
                    </th>
                    <th>
                        Last Updated
                    </th>
                    <th class="song_manage_column">
                        Manage
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var song in Model)
                    {
                        <tr>
                            <td class="song_number">
                                @song.SongCount
                            </td>
                            <td class="song_title">
                                @song.Song.SongTitleKa
                            </td>
                            <td class="song_date">
                                @TimeZoneInfo.ConvertTimeBySystemTimeZoneId(
                                    song.Song.CreatedDate,
                                    "India Standard Time"
                                ).ToString("dd MMM yyyy, hh:mm tt")
                            </td>
                            <td class="song_date">
                                @if (song.Song.UpdateDate.HasValue)
                                {
                                    @TimeZoneInfo.ConvertTimeBySystemTimeZoneId(
                                        song.Song.UpdateDate.Value,
                                        "India Standard Time"
                                    ).ToString("dd MMM yyyy, hh:mm tt")
                                }
                                else
                                {
                                    <span class="not_updated">Not updated</span>
                                }
                            </td>
                            <td class="song_actions">
                                <a class="song_action_button edit" asp-area="Admin" asp-controller="Home" asp-action="Upsert" asp-route-id="@song.Song.SongId">Edit</a>
                                <button type="button"
                                        class="song_action_button delete"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-song-id="@song.Song.SongId"
                                        data-song-title="@song.Song.SongTitleKa"
                                        data-created-date="@TimeZoneInfo.ConvertTimeBySystemTimeZoneId(song.Song.CreatedDate, "India Standard Time").ToString("dd MMM yyyy, hh:mm tt")" data-updated-date="@(song.Song.UpdateDate.HasValue ? TimeZoneInfo.ConvertTimeBySystemTimeZoneId(song.Song.UpdateDate.Value, "India Standard Time").ToString("dd MMM yyyy, hh:mm tt") : "Not updated")">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="songs_empty_state">
                                <strong>No songs found</strong>
                                <span>There are currently no songs available.</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete confirmation modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin_modal">
            <div class="modal-header">
                <div class="modal_title_wrapper">
                    <div class="modal_icon delete_modal_icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                            <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z" />
                        </svg>
                    </div>
                    <h1 class="modal-title" id="deleteModalLabel">Delete song?</h1>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete<strong id="deleteSongTitle"></strong>?</p>
                <div class="delete_song_details">
                    <div class="delete_song_detail">
                        <span>Created</span>
                        <strong id="deleteCreatedDate"></strong>
                    </div>
                    <div class="delete_song_detail">
                        <span>Last updated</span>
                        <strong id="deleteUpdatedDate"></strong>
                    </div>
                </div>
                <span class="delete_warning">This action cannot be undone.</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="admin_modal_cancel" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteSongForm" method="post" asp-area="Admin" asp-controller="Home" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteSongId" name="id" />
                    <button type="submit" class="admin_modal_delete">Delete Song</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", () => {
        // Alerts
        const alerts = document.querySelectorAll(".admin_alert");
        alerts.forEach(alert => {
            setTimeout(() => {
                const bootstrapAlert = bootstrap.Alert.getOrCreateInstance(alert);
                bootstrapAlert.close();
            }, 5000);
        });

        // Delete modal
        const deleteModal = document.getElementById("deleteModal");
        const deleteSongId = document.getElementById("deleteSongId");
        const deleteSongTitle = document.getElementById("deleteSongTitle");
        const deleteCreatedDate = document.getElementById("deleteCreatedDate");
        const deleteUpdatedDate = document.getElementById("deleteUpdatedDate");
        deleteModal.addEventListener("show.bs.modal", event => {
            const button = event.relatedTarget;
            const songId = button.getAttribute("data-song-id");
            const songTitle = button.getAttribute("data-song-title");
            const createdDate = button.getAttribute("data-created-date");
            const updatedDate = button.getAttribute("data-updated-date");
            deleteSongId.value = songId;
            deleteSongTitle.textContent = `"${songTitle}"`;
            deleteCreatedDate.textContent = createdDate;
            deleteUpdatedDate.textContent = updatedDate;
        });
    });
</script>