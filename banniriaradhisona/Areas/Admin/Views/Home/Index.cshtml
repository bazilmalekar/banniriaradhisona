@model IEnumerable<SongVM>

<div class="admin_index">
    <!-- PAGE HEADER -->
    <div class="admin_page_header">
        <div class="admin_page_title">
            <span class="admin_page_eyebrow">Content Management</span>
            <h1>Songs</h1>
            <p>Manage the songs available in Banniriaradhisona.</p>
        </div>
        <div class="admin_page_actions">
            <!-- SEARCH -->
            <div class="admin_song_search">
                <input type="text" id="songSearch" placeholder="Search by song number or English title..." autocomplete="off" />
            </div>
            <!-- ADD SONG -->
            <a class="admin_primary_button" asp-area="Admin" asp-controller="Home" asp-action="Upsert">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="16"
                     height="16"
                     fill="currentColor"
                     viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2" />
                </svg>
                Add song
            </a>
            <!-- EXPORT -->
            <a class="admin_secondary_button"
               asp-area="Admin"
               asp-controller="Home"
               asp-action="DownloadSongsPdf">

                <svg xmlns="http://www.w3.org/2000/svg"
                     width="16"
                     height="16"
                     fill="currentColor"
                     viewBox="0 0 16 16">
                    <path fill-rule="evenodd"
                          d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z" />
                    <path fill-rule="evenodd"
                          d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                </svg>

                Export Songs
            </a>
        </div>
    </div>

    <!-- SUCCESS ALERT -->
    @if (TempData["successMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show admin_alert" role="alert">
            <strong>Success!</strong>
            @TempData["successMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <!-- ERROR ALERT -->
    @if (TempData["errorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show admin_alert" role="alert">
            <strong>Error!</strong>
            @TempData["errorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- SONG TABLE -->
    <div class="songs_table_wrapper">
        <table class="songs_list" id="songsTable">
            <thead>
                <tr>
                    <th class="song_number_column">
                        Song No.
                    </th>
                    <th>
                        Song Title
                    </th>
                    <th>
                        Created
                    </th>
                    <th>
                        Last Updated
                    </th>
                    <th class="song_manage_column">
                        Manage
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var song in Model)
                    {
                        <!--
                            IMPORTANT:
                            song_row is used by JavaScript.

                            data-song-number:
                            Used when searching by song number.

                            data-song-title:
                            Used when searching by ENGLISH title.
                        -->
                        <tr class="song_row" data-song-number="@song.SongCount" data-song-title="@song.Song.SongTitleEn">
                            <!-- SONG NUMBER -->
                            <td class="song_number">
                                @song.SongCount
                            </td>
                            <!-- SONG TITLE -->
                            <td class="song_title">
                                @song.Song.SongTitleKa
                            </td>
                            <!-- CREATED DATE -->
                            <td class="song_date">
                                @TimeZoneInfo.ConvertTimeBySystemTimeZoneId(
                                    song.Song.CreatedDate,
                                    "India Standard Time"
                                ).ToString("dd MMM yyyy, hh:mm tt")
                            </td>
                            <!-- UPDATED DATE -->
                            <td class="song_date">
                                @if (song.Song.UpdateDate.HasValue)
                                {
                                    @TimeZoneInfo.ConvertTimeBySystemTimeZoneId(
                                        song.Song.UpdateDate.Value,
                                        "India Standard Time"
                                    ).ToString("dd MMM yyyy, hh:mm tt")
                                }
                                else
                                {
                                    <span class="not_updated">Not updated</span>
                                }
                            </td>
                            <!-- ACTIONS -->
                            <td class="song_actions">
                                <!-- EDIT -->
                                <a class="song_action_button edit" asp-area="Admin" asp-controller="Home" asp-action="Upsert" asp-route-id="@song.Song.SongId">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="15"
                                         height="15"
                                         fill="currentColor"
                                         viewBox="0 0 16 16">
                                        <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293z" />
                                        <path d="m12.939 2.69-8 8-.805 2.414 2.414-.805 8-8z" />
                                        <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                                    </svg>
                                    Edit
                                </a>
                                <!-- DELETE -->
                                <button type="button"
                                        class="song_action_button delete"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-song-id="@song.Song.SongId"
                                        data-song-title="@song.Song.SongTitleKa"
                                        data-created-date="@TimeZoneInfo.ConvertTimeBySystemTimeZoneId(
                                                                                                                        song.Song.CreatedDate,
                                                                                                                        "India Standard Time"
                                                                                                                        ).ToString("dd MMM yyyy, hh:mm tt")"
                                        data-updated-date="@(song.Song.UpdateDate.HasValue
                                                                                                                        ? TimeZoneInfo.ConvertTimeBySystemTimeZoneId(
                                                                                                                            song.Song.UpdateDate.Value,
                                                                                                                            "India Standard Time"
                                                                                                                        ).ToString("dd MMM yyyy, hh:mm tt")
                                                                                                                : "Not updated")">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="15"
                                         height="15"
                                         fill="currentColor"
                                         viewBox="0 0 16 16">
                                        <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5" />
                                        <path d="M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1z" />
                                    </svg>
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="songs_empty_state">
                                <strong>No songs found</strong>
                                <span>There are currently no songs available.</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<!-- DELETE CONFIRMATION MODAL -->
<div class="modal fade" id="deleteModal"
     tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin_modal">
            <div class="modal-header">
                <div class="modal_title_wrapper">
                    <div class="modal_icon delete_modal_icon">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="20"
                             height="20"
                             fill="currentColor"
                             viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                            <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z" />
                        </svg>
                    </div>
                    <h1 class="modal-title" id="deleteModalLabel">Delete song?</h1>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    Are you sure you want to delete
                    <strong id="deleteSongTitle"></strong>?
                </p>
                <div class="delete_song_details">
                    <div class="delete_song_detail">
                        <span>Created</span>
                        <strong id="deleteCreatedDate"></strong>
                    </div>
                    <div class="delete_song_detail">
                        <span>Last updated</span>
                        <strong id="deleteUpdatedDate"></strong>
                    </div>
                </div>
                <span class="delete_warning">This action cannot be undone.</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="admin_modal_cancel" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteSongForm" method="post" asp-area="Admin" asp-controller="Home" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteSongId" name="id" />
                    <button type="submit" class="admin_modal_delete">Delete Song</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", () => {
        // ALERTS
        const alerts = document.querySelectorAll(".admin_alert");
        alerts.forEach(alert => {
            setTimeout(() => {
                const bootstrapAlert = bootstrap.Alert.getOrCreateInstance(alert);
                bootstrapAlert.close();
            }, 5000);
        });


        // DELETE MODAL
        const deleteModal = document.getElementById("deleteModal");
        const deleteSongId = document.getElementById("deleteSongId");
        const deleteSongTitle = document.getElementById("deleteSongTitle");
        const deleteCreatedDate = document.getElementById("deleteCreatedDate");
        const deleteUpdatedDate = document.getElementById("deleteUpdatedDate");
        if (deleteModal) {
            deleteModal.addEventListener(
                "show.bs.modal",
                event => {
                    const button = event.relatedTarget;
                    const songId = button.getAttribute("data-song-id");
                    const songTitle = button.getAttribute("data-song-title");
                    const createdDate = button.getAttribute("data-created-date");
                    const updatedDate = button.getAttribute("data-updated-date");
                    deleteSongId.value = songId;
                    deleteSongTitle.textContent = `"${songTitle}"`;
                    deleteCreatedDate.textContent = createdDate;
                    deleteUpdatedDate.textContent = updatedDate;
                }
            );
        }

        // SONG SEARCH
        const searchInput = document.getElementById("songSearch");
        const songRows = document.querySelectorAll(".song_row");
        const tableBody = document.querySelector("#songsTable tbody");
        if (!searchInput) {
            return;
        }
        let searchTimeout;
        searchInput.addEventListener("input", () => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                const searchValue = searchInput.value.trim().toLowerCase();
                let visibleSongs = 0;
                songRows.forEach(row => {
                    // Get the song number. Example" "25"
                    const songNumber = row.dataset.songNumber ?.toLowerCase() ?? "";

                    // Get the English title.Example: "Amazing Grace"
                    const songTitle = row.dataset.songTitle ?.toLowerCase() ?? "";
                    // Match either Song number OR English title
                    const matches = songNumber.includes(searchValue) || songTitle.includes(searchValue);
                    if (matches) {
                        row.style.display = "";
                        visibleSongs++;
                    }
                    else {
                        row.style.display = "none";
                    }
                });

                // NO SEARCH RESULTS
                let noResults = document.getElementById("noSearchResults");
                if (!noResults) {
                    noResults = document.createElement("tr");
                    noResults.id = "noSearchResults";
                    noResults.innerHTML = `
                        <td colspan="5">
                            <div class="songs_empty_state">
                                <strong>No songs found</strong>
                                <span>No songs match your search.</span>
                            </div>
                        </td>
                    `;
                    tableBody.appendChild(noResults);
                }
                noResults.style.display = visibleSongs === 0 ? "" : "none";
            }, 250);
        });
    });
</script>