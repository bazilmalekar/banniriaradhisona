<script>
    document.addEventListener("DOMContentLoaded", () => {

        const searchInput = document.getElementById("songSearch");
        const songLinks = document.querySelectorAll(".song_link");
        const noSongsFound = document.getElementById("noSongsFound");

        if (!searchInput) {
            return;
        }

        let searchTimeout;

        searchInput.addEventListener("input", () => {

            clearTimeout(searchTimeout);

            searchTimeout = setTimeout(() => {

                const searchValue = searchInput.value
                    .trim()
                    .toLowerCase();

                let visibleSongs = 0;

                songLinks.forEach(song => {

                    const songNumber =
                        song.dataset.songNumber?.toLowerCase() ?? "";

                    const songTitle =
                        song.dataset.songTitle?.toLowerCase() ?? "";

                    const matches =
                        songNumber.includes(searchValue) ||
                        songTitle.includes(searchValue);

                    if (matches) {

                        song.style.display = "block";

                        // Restart animation
                        song.classList.remove("filter_show");

                        void song.offsetWidth;

                        song.classList.add("filter_show");

                        visibleSongs++;
                    }
                    else {

                        song.style.display = "none";

                        song.classList.remove("filter_show");
                    }
                });

                noSongsFound.style.display =
                    visibleSongs === 0 ? "block" : "none";

            }, 250); // 250ms debounce

        });

    });
</script>