@model IEnumerable<banniriaradhisona.Core.ViewModels.SidebarVM>;

<div class="side_bar">
    <div class="sidebar_search">
        <input type="text" placeholder="Search by song number or title..." />
    </div>
    <div class="sidebar_links">
        @foreach (var song in Model)
        {
            <a class="song_link" asp-controller="Home" asp-action="Index" asp-route-songId="@song.SongId">
                <h6>Song No. @song.SongCount</h6>
                <p>@song.SongTitle</p>
            </a>
        }

    </div>
</div>