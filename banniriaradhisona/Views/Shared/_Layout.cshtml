<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (ViewData["Title"] != null)
    {
        <title>
            @ViewData["Title"]
            -
            Banniriaradhisona
        </title>
    }
    else
    {
        <title>
            Banniriaradhisona
        </title>
    }
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/banniriaradhisona.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
</head>
<body>
    <div class="main">
        <partial name="_NavbarPratial" />
        @await Component.InvokeAsync("MobileSidebar")
        <main class="app_body_wrapper">
            <script src="~/lib/jquery/dist/jquery.min.js"></script>
            @RenderBody()
        </main>
        <footer class="custom_footer">
            <p>&copy; @DateTime.Now.Year ಆರಾಧಿಸುವಾ. All rights reserved.</p>
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    
    <script>
        document.addEventListener("DOMContentLoaded", () => {

        const toggle = document.getElementById("mobileSidebarToggle");
        const sidebar = document.getElementById("mobileSidebar");
        const close = document.getElementById("mobileSidebarClose");
        const overlay = document.getElementById("mobileSidebarOverlay");

        if (!toggle || !sidebar) {
        return;
        }

        const openSidebar = () => {
        sidebar.classList.add("open");
        overlay?.classList.add("open");
        toggle.classList.add("open");
        toggle.setAttribute("aria-expanded", "true");
        };

        const closeSidebar = () => {
        sidebar.classList.remove("open");
        overlay?.classList.remove("open");
        toggle.classList.remove("open");
        toggle.setAttribute("aria-expanded", "false");
        };

        toggle.addEventListener("click", openSidebar);
        close?.addEventListener("click", closeSidebar);
        overlay?.addEventListener("click", closeSidebar);

        sidebar.querySelectorAll(".song_link").forEach(link => {
        link.addEventListener("click", closeSidebar);
        });

        document.addEventListener("keydown", event => {
        if (event.key === "Escape") {
        closeSidebar();
        }
        });

        });
    </script>
</body>
</html>

